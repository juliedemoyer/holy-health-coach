# Holy dashboard — env vars
#
# Copy to .env.local for local dev, and set the same keys in your deploy
# target's environment variables. Never commit .env.local.
#
# None of this is needed to look around: run `npm run dev` and open
# /?demo=1 for the whole dashboard with fictional data and no backend.

# ── Supabase ───────────────────────────────────────────────────────────────

# Project URL. Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key. Safe client-side: RLS is what protects the data.
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Personal values — keep these OUT of config/ and out of git ─────────────
#
# config/athlete.json carries example fallbacks so the demo renders. Your
# real values belong here and in your deploy target's secrets, nowhere else.

# Height in cm. Used for the BMI helper only.
VITE_HEIGHT_CM=

# Date of birth (YYYY-MM-DD). Drives the age-derived tiles and the
# age-group percentile ranking. Never rendered literally in the UI.
VITE_BIRTHDATE=

# "female" | "male". Used only for a handful of reference ranges.
VITE_SEX=

# ── Race overrides (optional — config/race.json is the default) ────────────
VITE_RACE_NAME=
VITE_RACE_SHORT_NAME=
VITE_RACE_DATE=

# ── Branding (optional) ────────────────────────────────────────────────────
# Product name in the nav and on the sign-in page. Defaults to "Holy".
VITE_APP_NAME=
VITE_ATHLETE_NAME=

# ── Optional extras ────────────────────────────────────────────────────────
# Podcast link surfaced on the marathons page. Omit and the card hides.
VITE_NOTEBOOK_LM_URL=

# Social link on the public page. Leave both empty and the link hides.
VITE_INSTAGRAM_URL=
VITE_INSTAGRAM_HANDLE=
