# Holy dashboard — env vars
#
# Copy to .env.local for local dev, and set the same keys in your deploy
# target's environment variables. Never commit .env.local.
#
# None of this is needed to look around: run `npm run dev` and open
# /?demo=1 for the whole dashboard with fictional data and no backend.

# ── Supabase ───────────────────────────────────────────────────────────────

# Project URL. Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key. Safe client-side: RLS is what protects the data.
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Personal values are NOT env vars. Do not add them here. ────────────────
#
# Height, date of birth and sex live in the RLS-locked `config` table. Run
# migration 0017 and set them with the INSERT at the bottom of that file.
#
# They used to be VITE_HEIGHT_CM, VITE_BIRTHDATE and VITE_SEX, and that was a
# mistake worth spelling out: Vite inlines every VITE_-prefixed variable into
# the client bundle at build time. A real date of birth ended up as a literal
# string in a publicly downloadable .js asset. Keeping it out of a committed
# file moved it from the repo into the bundle. Holding it as a deploy-target
# secret does not help either, because the build reads the secret and writes
# the value into the bundle.
#
# The rule: treat anything VITE_-prefixed as published. The anon key above is
# the one value that is designed to be public, and RLS is what protects the
# data behind it.

# ── Race overrides (optional — config/race.json is the default) ────────────
VITE_RACE_NAME=
VITE_RACE_SHORT_NAME=
VITE_RACE_DATE=

# ── Branding (optional) ────────────────────────────────────────────────────
# Product name in the nav and on the sign-in page. Defaults to "Holy".
VITE_APP_NAME=
VITE_ATHLETE_NAME=

# ── Optional extras ────────────────────────────────────────────────────────
# Podcast link surfaced on the marathons page. Omit and the card hides.
VITE_NOTEBOOK_LM_URL=

# Social link on the public page. Leave both empty and the link hides.
VITE_INSTAGRAM_URL=
VITE_INSTAGRAM_HANDLE=
